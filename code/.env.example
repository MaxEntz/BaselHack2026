# Copy to .env (make setup does it). Local dev values only: never commit .env.

# Host port of the docker-compose Postgres; change it (and DATABASE_URL) if 5432 is taken.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://merchant:merchant@localhost:5432/merchant_agents

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

MERCHANT_TZ=Europe/Zurich
AGENT_TIMEOUT_MS=2000

# Public HTTPS URL of the tunnel in front of the gateway (Claude.ai connector),
# e.g. https://<your-static-domain>.ngrok-free.app
GATEWAY_PUBLIC_URL=
# Optional: bearer token required on /mcp when set.
GATEWAY_TOKEN=

PLATFORM_PUBLIC_URL=http://localhost:8002
# read_write | read_only | off
BUILDER_CACHE=read_write
# 1 lets the crawler load localhost (the demo site runs locally).
CRAWL_ALLOW_PRIVATE=1
