# Copy to .env (make setup does it). Local dev values only: never commit .env.

# Host port of the docker-compose Postgres; change it (and DATABASE_URL) if 5432 is taken.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://merchant:merchant@localhost:5432/merchant_agents

# The one key for every backend LLM call: the builder and the platform assistant (the platform's
# process), the merchant's agent (the BATP node's). On the team server, each process has its own
# file, so the key is in both: platform/.env and code/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

MERCHANT_TZ=Europe/Zurich
AGENT_TIMEOUT_MS=2000
# The gateway reaches the merchant agents through a BATP node, e.g. batp://127.0.0.1:4710.
# Empty: they run in the gateway's process. Also what Studio's Send buttons go through (#151):
# the platform connects as urn:batp:agent:sesame-studio, so BATP_TOKENS needs that key too when
# it has any. The guest agent of `make guest` (#252) connects as urn:batp:agent:sesame-guest and
# reads its token from its own key there.
BATP_URL=
BATP_TOKEN=
# Fault injection: delay before each agent call (above AGENT_TIMEOUT_MS it triggers the fallback),
# limited to these comma-separated slugs when set.
CHAOS_DELAY_MS=0
CHAOS_MERCHANTS=

# Public HTTPS URL in front of the gateway (Claude.ai connector), without /mcp.
# Team server: https://191-96-88-152.sslip.io
# Alternative, local gateway behind ngrok (make tunnel): https://<your-static-domain>.ngrok-free.app
GATEWAY_PUBLIC_URL=
# Where a server serves the demo sites, as <slug>.<domain>: the seeded merchants' links point
# there. Team server: 191-96-88-152.sslip.io. Empty: their local addresses (make sites).
DEMO_SITES_DOMAIN=
# Bearer token required on /mcp when set. Optional locally; required on the team server, where
# Caddy adds it for Claude.ai and every other assistant sends it (ADR-0019).
GATEWAY_TOKEN=

PLATFORM_PUBLIC_URL=http://localhost:8002
# JSON list of origins allowed to post the showcase site's booking form.
PUBLIC_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# 0 disables POST /dev/reset-session. Local development only: the platform refuses to start
# with it on beside an https PLATFORM_WEB_URL, a PLATFORM_COOKIE_SECRET or a PLATFORM_INVITE_CODE.
# So setting a cookie secret or an invite code below, even locally, means setting this to 0.
PLATFORM_DEV_ROUTES=1
# Merchant accounts (#132): where merchants open the web app (start of the secret links), the
# key that signs their cookies (any long random string; unset = a new key per run), and the code
# a new build needs (unset = none asked, for local development).
PLATFORM_WEB_URL=http://localhost:5173
PLATFORM_COOKIE_SECRET=
PLATFORM_INVITE_CODE=
# Development only, never on the server: start the merchant chat as this merchant (skips
# onboarding), whose pages and live events then open without its link, e.g. le-petit-zinc.
PLATFORM_MERCHANT=
# Platform assistant reasoning effort (none | low | medium | high).
OPENAI_REASONING_EFFORT=low
# read_write | read_only | off
BUILDER_CACHE=read_write
# Reasoning effort of the builder's extraction (none | low | medium | high).
BUILDER_REASONING_EFFORT=none
# Reasoning effort of the merchants' agents, which the BATP node runs with OPENAI_API_KEY and
# OPENAI_MODEL (none | low | medium | high).
AGENT_REASONING_EFFORT=low
# 1 lets the crawler load localhost (the demo site runs locally).
CRAWL_ALLOW_PRIVATE=1

# BATP node (documentation/PROTOCOL.md): loopback only in the POC (ADR-0011).
BATP_HOST=127.0.0.1
BATP_PORT=4710
# Known agents and their tokens, as JSON. Empty = any agent, allowed on loopback only.
BATP_TOKENS=
# The node's TLS certificate and key (PEM file paths), required beyond loopback.
# BATP_TLS_CERT=
# BATP_TLS_KEY=

# On the team server (#142, documentation/runbooks/platform.md), the platform runs as its own
# user with its own settings file, /opt/merchant-agents/platform/.env (never committed):
#   DATABASE_URL=…, OPENAI_API_KEY=…
#   GATEWAY_PUBLIC_URL=https://191-96-88-152.sslip.io
#   PLATFORM_PUBLIC_URL=https://sesame.191-96-88-152.sslip.io
#   PUBLIC_CORS_ORIGINS=["https://le-petit-zinc.191-96-88-152.sslip.io"]
#   PLATFORM_DEV_ROUTES=0          (make deploy refuses to deploy without it)
#   CRAWL_ALLOW_PRIVATE=0          (the crawler runs on a shared machine)
#   PLATFORM_WEB_URL=https://sesame.191-96-88-152.sslip.io
#   PLATFORM_COOKIE_SECRET=        (at least 32 random characters)
#   PLATFORM_INVITE_CODE=          (at least 8 characters, given to the merchants we invite)
# make deploy refuses to deploy without each of them set, or with PLATFORM_MERCHANT set.
