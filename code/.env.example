# Copy to .env (make setup does it). Local dev values only: never commit .env.

# Host port of the docker-compose Postgres; change it (and DATABASE_URL) if 5432 is taken.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://merchant:merchant@localhost:5432/merchant_agents

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

MERCHANT_TZ=Europe/Zurich
AGENT_TIMEOUT_MS=2000
# The gateway reaches the merchant agents through a MATP node, e.g. matp://127.0.0.1:4710.
# Empty: they run in the gateway's process.
MATP_URL=
MATP_TOKEN=
# Fault injection: delay before each agent call (above AGENT_TIMEOUT_MS it triggers the fallback),
# limited to these comma-separated slugs when set.
CHAOS_DELAY_MS=0
CHAOS_MERCHANTS=

# Public HTTPS URL of the tunnel in front of the gateway (Claude.ai connector),
# e.g. https://<your-static-domain>.ngrok-free.app
GATEWAY_PUBLIC_URL=
# Optional: bearer token required on /mcp when set.
GATEWAY_TOKEN=

PLATFORM_PUBLIC_URL=http://localhost:8002
# JSON list of origins allowed to post the showcase site's booking form.
PUBLIC_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# 0 disables POST /dev/reset-session.
PLATFORM_DEV_ROUTES=1
# Start the merchant chat as this merchant (skips onboarding), e.g. le-petit-zinc.
PLATFORM_MERCHANT=
# Platform assistant reasoning effort (none | low | medium | high).
OPENAI_REASONING_EFFORT=low
# read_write | read_only | off
BUILDER_CACHE=read_write
# Reasoning effort of the builder's extraction (none | low | medium | high).
BUILDER_REASONING_EFFORT=none
# 1 lets the crawler load localhost (the demo site runs locally).
CRAWL_ALLOW_PRIVATE=1

# MATP node (documentation/PROTOCOL.md): loopback only in the POC (ADR-0011).
MATP_HOST=127.0.0.1
MATP_PORT=4710
# Known agents and their tokens, as JSON. Empty = any agent, allowed on loopback only.
MATP_TOKENS=
