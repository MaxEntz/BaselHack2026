[Unit]
Description=Sésame MCP gateway
# Wants, not Requires: when the node stops, the gateway stays up and gives the fallback links.
After=network-online.target merchant-node.service
Wants=network-online.target merchant-node.service

[Service]
User=gateway
WorkingDirectory=/opt/merchant-agents/code
ExecStart=/opt/merchant-agents/code/.venv/bin/python -m gateway
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
