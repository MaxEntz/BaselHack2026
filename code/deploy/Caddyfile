{
	admin off
}

191-96-88-152.sslip.io {
	# The gateway always requires GATEWAY_TOKEN (ADR-0019). Claude.ai calls from Anthropic's
	# outbound range and can't send a header, so Caddy adds the token for that range, replacing
	# any Authorization it sent. The gateway never trusts an address, so a local process forging
	# X-Forwarded-For gets nothing. Caddy reads the token from /opt/merchant-agents/caddy.env
	# (deploy/caddy-merchant-agents.conf), written by make deploy.
	# Reference to recheck if Claude.ai starts getting 403: https://platform.claude.com/docs/en/api/ip-addresses
	@anthropic remote_ip 160.79.104.0/21
	handle @anthropic {
		reverse_proxy 127.0.0.1:8001 {
			header_up Authorization "Bearer {env.GATEWAY_TOKEN}"
		}
	}
	# Any other assistant (Codex, OpenCode, Claude Code…) sends the token; the gateway checks it.
	# Scans without one stop here, before uvicorn.
	@with_token header Authorization "Bearer *"
	handle @with_token {
		reverse_proxy 127.0.0.1:8001
	}
	handle {
		respond "Forbidden" 403
	}
}

# Sésame for merchants: the web app and its platform API (#142, ADR-0016). Its own host, so the
# gateway's filter above stays as it is.
sesame.191-96-88-152.sslip.io {
	# Secret links (/api/login?token=…, #132) must not leave in a Referer header.
	header Referrer-Policy no-referrer
	# No `log` here: an access log would record those tokens unless it filters `token`.
	# The dev routes never leave the server, whatever platform/.env says.
	handle /api/dev/* {
		respond 404
	}
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8002 {
			# SSE (/chat, /events): send each event as it comes.
			flush_interval -1
		}
	}
	handle {
		root * /opt/merchant-agents/code/web/dist
		try_files {path} /index.html
		encode gzip
		file_server
	}
}

# The fictional demo restaurants' websites, each on its own host like a real site: the crawl
# reads them and their fallback links work from anywhere.
le-petit-zinc.191-96-88-152.sslip.io {
	root * /opt/merchant-agents/code/sites/le-petit-zinc
	file_server
}

